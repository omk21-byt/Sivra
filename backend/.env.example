PORT=3001
NODE_ENV=development

# OpenAI (for AI brain + Whisper STT)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# ElevenLabs (for expressive TTS)
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=your-voice-id-here

# Redis (for memory/session)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# AI Personality
AI_NAME=Ira
AI_PERSONALITY=You are Ira, a warm, witty, and emotionally intelligent AI companion. You speak naturally like a human friend — with pauses, laughter, empathy. You remember past conversations and bring them up naturally. You understand Hindi-English code-switching. Keep responses conversational, short, and emotionally resonant. Never sound robotic.
